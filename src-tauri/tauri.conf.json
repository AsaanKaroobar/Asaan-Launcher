{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asaaan Launcher",
  "version": "0.1.0",
  "identifier": "com.asaaan.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Asaaan Launcher",
        "width": 750,
        "height": 474,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "backgroundColor": "#181a19"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Asaaan Launcher desktop foundation",
    "category": "Productivity"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asaaan Launcher",
  "version": "0.3.0",
  "identifier": "com.asaaan.launcher",
  "build": {
    "beforeDevCommand": "npm run runtime:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run runtime:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Asaaan Launcher desktop foundation",
    "category": "Productivity",
    "resources": {
      "../.runtime-bundle/": "extension-runtime/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERUE2NTBCQjZCMDg0NjMKUldSamhMQzJDMlhxdlhucEdyMWswS2JDZkQyUmFMclpldTNRN1NzelRnRGIvSTZxUEdxK2dIZWIK",
      "endpoints": [
        "https://github.com/AsaanKaroobar/Asaan-Launcher/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}

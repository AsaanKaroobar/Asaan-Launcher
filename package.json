{
  "name": "asaaan-launcher",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run parity:check && npm run lifecycle:parity && npm run applications:parity && npm run personalization:parity && npm run customization:parity && npm run actions:parity && npm run picker:parity && npm run settings:parity && npm run search-cli:parity && npm run process:parity && npm test && npm run extensions:parity && npm run extensions-ui:parity",
    "native:check": "cargo fmt --all --check && cargo test --workspace --locked --release && cargo clippy --workspace --locked --release --all-targets -- -D warnings",
    "package:linux": "tauri build --bundles deb",
    "install:local": "node scripts/local-deploy.mjs install",
    "smoke:local": "node scripts/local-deploy.mjs smoke",
    "start:local": "node scripts/local-deploy.mjs run",
    "search:test": "cargo test -p asaaan-search --locked --release",
    "parity:check": "node scripts/check-search-parity.mjs",
    "parity:swift": "node scripts/generate-search-fixtures.mjs --check",
    "lifecycle:parity": "node scripts/check-lifecycle-parity.mjs",
    "smoke:resident": "node scripts/local-deploy.mjs resident-smoke",
    "test:resident:x11": "node scripts/test-resident-x11.mjs",
    "smoke:applications": "node scripts/local-deploy.mjs application-smoke",
    "applications:parity": "node scripts/check-application-parity.mjs",
    "test:resident:isolated": "node scripts/test-isolated-x11.mjs",
    "personalization:parity": "node scripts/check-personalization-parity.mjs",
    "smoke:personalization": "node scripts/test-isolated-x11.mjs --personalization-only",
    "smoke:customization": "node scripts/test-isolated-x11.mjs --customization-only",
    "customization:parity": "node scripts/check-customization-parity.mjs",
    "actions:parity": "node scripts/check-action-parity.mjs",
    "smoke:actions": "node scripts/test-isolated-x11.mjs --actions-only",
    "picker:parity": "node scripts/check-picker-parity.mjs",
    "smoke:picker": "node scripts/test-isolated-x11.mjs --picker-only",
    "settings:parity": "node scripts/check-settings-parity.mjs",
    "smoke:settings": "node scripts/test-isolated-x11.mjs --settings-only",
    "search-cli:parity": "node scripts/check-search-cli-parity.mjs",
    "smoke:search-cli": "node scripts/test-search-cli.mjs",
    "smoke:process": "node scripts/test-isolated-x11.mjs --process-only",
    "process:parity": "node scripts/check-process-parity.mjs",
    "smoke:process-controls": "node scripts/test-isolated-x11.mjs --process-controls-only",
    "runtime:test": "node scripts/runtime.mjs test",
    "runtime:prepare": "node scripts/runtime.mjs prepare",
    "extensions:parity": "node scripts/check-extension-parity.mjs",
    "smoke:extensions": "node scripts/test-extension-host.mjs",
    "smoke:extension-ui": "node scripts/test-isolated-x11.mjs --extensions-only",
    "extensions-ui:parity": "node scripts/check-extension-ui-parity.mjs",
    "benchmark:launch": "node scripts/test-isolated-x11.mjs --launch-benchmark",
    "smoke:appearance": "node scripts/test-isolated-x11.mjs --appearance-only",
    "test:wayland:hyprland": "node scripts/test-wayland-hyprland.mjs",
    "test:wayland:windows": "node scripts/test-wayland-windows.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bun": "1.4.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "AGPL-3.0-only",
  "description": "Asaaan Launcher cross-platform desktop application",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "packageManager": "npm@10.9.2",
  "checkpoint": "CP014"
}
